#!/usr/bin/env bash
# shellcheck shell=bash
set -Eeuo pipefail

MANAGER="auto"
DRY_RUN=0
YES=0
UPDATE=1
CLEANUP=0
PACKAGE_FILE=""
declare -a PACKAGES=()

usage() {
  cat <<'EOF'
Usage: install-packages [OPTIONS] PACKAGE_FILE

Install one package per line from a portable package list. Blank lines and
comments are ignored.

Options:
  --manager NAME  auto, apt, brew, dnf, yum, pacman, or apk
  --dry-run       Show the exact commands without changing the system
  --yes           Skip confirmation
  --no-update     Skip package-index refresh
  --cleanup       Clean the package-manager cache after a successful install
  --help          Show this help
EOF
}

detect_manager() {
  local manager_name
  for manager_name in brew apt-get dnf yum pacman apk; do
    if command -v "${manager_name}" >/dev/null 2>&1; then
      case "${manager_name}" in apt-get) printf "apt\n" ;; *) printf "%s\n" "${manager_name}" ;; esac
      return 0
    fi
  done
  return 1
}

print_command() {
  printf "+"
  printf " %q" "$@"
  printf "\n"
}

run() {
  print_command "$@"
  ((DRY_RUN == 1)) || "$@"
}

while (($# > 0)); do
  case "$1" in
    --manager)
      (($# >= 2)) || { printf "install-packages: --manager requires a value\n" >&2; exit 64; }
      MANAGER="$2"
      shift 2
      ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes) YES=1; shift ;;
    --no-update) UPDATE=0; shift ;;
    --cleanup) CLEANUP=1; shift ;;
    --help|-h) usage; exit 0 ;;
    --*) printf "install-packages: unknown option: %s\n" "$1" >&2; exit 64 ;;
    *)
      [[ -z "${PACKAGE_FILE}" ]] || { printf "install-packages: only one package file is accepted\n" >&2; exit 64; }
      PACKAGE_FILE="$1"
      shift
      ;;
  esac
done

[[ -n "${PACKAGE_FILE}" ]] || { usage >&2; exit 64; }
[[ -r "${PACKAGE_FILE}" ]] || { printf "install-packages: cannot read: %s\n" "${PACKAGE_FILE}" >&2; exit 66; }

if [[ "${MANAGER}" == "auto" ]]; then
  MANAGER="$(detect_manager)" || { printf "install-packages: no supported package manager found\n" >&2; exit 69; }
fi

case "${MANAGER}" in apt|brew|dnf|yum|pacman|apk) ;; *) printf "install-packages: unsupported manager: %s\n" "${MANAGER}" >&2; exit 64 ;; esac

while IFS= read -r package_line || [[ -n "${package_line}" ]]; do
  package_line="${package_line%%#*}"
  package_line="${package_line#"${package_line%%[![:space:]]*}"}"
  package_line="${package_line%"${package_line##*[![:space:]]}"}"
  [[ -n "${package_line}" ]] && PACKAGES+=("${package_line}")
done < "${PACKAGE_FILE}"

((${#PACKAGES[@]} > 0)) || { printf "install-packages: no packages found in %s\n" "${PACKAGE_FILE}" >&2; exit 65; }

printf "manager: %s\npackages: %d\nsource: %s\n" "${MANAGER}" "${#PACKAGES[@]}" "${PACKAGE_FILE}"
printf "  %s\n" "${PACKAGES[@]}"

if ((DRY_RUN == 0 && YES == 0)); then
  [[ -t 0 ]] || { printf "install-packages: confirmation requires a terminal; use --yes\n" >&2; exit 64; }
  printf "Continue? [y/N] "
  read -r answer
  case "${answer}" in y|Y|yes|YES) ;; *) printf "Cancelled.\n"; exit 0 ;; esac
fi

declare -a PRIVILEGE=()
if [[ "${MANAGER}" != "brew" && "$(id -u)" -ne 0 ]]; then
  command -v sudo >/dev/null 2>&1 || { printf "install-packages: root or sudo is required for %s\n" "${MANAGER}" >&2; exit 77; }
  PRIVILEGE=(sudo)
fi

case "${MANAGER}" in
  apt)
    ((UPDATE == 0)) || run "${PRIVILEGE[@]}" apt-get update
    run "${PRIVILEGE[@]}" apt-get install --yes --no-install-recommends "${PACKAGES[@]}"
    ((CLEANUP == 0)) || run "${PRIVILEGE[@]}" apt-get clean
    ;;
  brew)
    ((UPDATE == 0)) || run brew update
    run brew install "${PACKAGES[@]}"
    ((CLEANUP == 0)) || run brew cleanup
    ;;
  dnf)
    ((UPDATE == 0)) || run "${PRIVILEGE[@]}" dnf makecache
    run "${PRIVILEGE[@]}" dnf install --assumeyes "${PACKAGES[@]}"
    ((CLEANUP == 0)) || run "${PRIVILEGE[@]}" dnf clean all
    ;;
  yum)
    ((UPDATE == 0)) || run "${PRIVILEGE[@]}" yum makecache
    run "${PRIVILEGE[@]}" yum install --assumeyes "${PACKAGES[@]}"
    ((CLEANUP == 0)) || run "${PRIVILEGE[@]}" yum clean all
    ;;
  pacman)
    run "${PRIVILEGE[@]}" pacman --sync --needed --noconfirm "${PACKAGES[@]}"
    ((CLEANUP == 0)) || run "${PRIVILEGE[@]}" pacman --sync --clean --noconfirm
    ;;
  apk)
    ((UPDATE == 0)) || run "${PRIVILEGE[@]}" apk update
    run "${PRIVILEGE[@]}" apk add "${PACKAGES[@]}"
    ((CLEANUP == 0)) || run "${PRIVILEGE[@]}" apk cache clean
    ;;
esac
