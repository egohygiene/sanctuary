#!/usr/bin/env bash
# shellcheck shell=bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
BANNER_FILE="${EGOHYGIENE_BANNER_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/egohygiene/banner.txt}"
LOGO_ONLY=0

usage() {
  cat <<'EOF'
Usage: shell-banner [--file PATH] [--logo-only] [--help]

Render an optional ANSI/text banner plus concise host and Git context.
EOF
}

while (($# > 0)); do
  case "$1" in
    --file) (($# >= 2)) || exit 64; BANNER_FILE="$2"; shift 2 ;;
    --force) shift ;; # Backward-compatible no-op.
    --logo-only) LOGO_ONLY=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) printf "shell-banner: unknown option: %s\n" "$1" >&2; exit 64 ;;
  esac
done

if [[ ! -r "${BANNER_FILE}" && -r "${ROOT}/assets/banner.txt" ]]; then
  BANNER_FILE="${ROOT}/assets/banner.txt"
fi

if [[ -r "${BANNER_FILE}" ]]; then
  printf "%b\n" "$(< "${BANNER_FILE}")"
fi

((LOGO_ONLY == 1)) && exit 0

printf "workspace: %s\n" "${PWD}"
printf "host:      %s\n" "$(hostname 2>/dev/null || printf unknown)"
printf "time:      %s\n" "$(date "+%Y-%m-%d %H:%M:%S %Z")"

if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  printf "repo:      %s\n" "$(basename "$(git rev-parse --show-toplevel)")"
  printf "branch:    %s\n" "$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)"
  printf "commit:    %s %s\n" "$(git rev-parse --short HEAD)" "$(git log -1 --pretty=%s)"
fi
