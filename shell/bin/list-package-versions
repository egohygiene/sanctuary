#!/usr/bin/env bash
# shellcheck shell=bash
set -Eeuo pipefail

FORMAT="table"
OUTPUT=""
declare -a REQUESTED_MANAGERS=()

usage() {
  cat <<'EOF'
Usage: list-package-versions [OPTIONS]

List installed packages across every detected package manager.

Options:
  --manager NAME  Include only one manager; repeatable
  --format NAME   table, tsv, json, or lock (default: table)
  --output FILE   Write the report to a file
  --help          Show this help
EOF
}

is_requested() {
  local candidate="$1"
  local requested
  ((${#REQUESTED_MANAGERS[@]} == 0)) && return 0
  for requested in "${REQUESTED_MANAGERS[@]}"; do
    [[ "${candidate}" == "${requested}" ]] && return 0
  done
  return 1
}

while (($# > 0)); do
  case "$1" in
    --manager)
      (($# >= 2)) || { printf "list-package-versions: --manager requires a value\n" >&2; exit 64; }
      REQUESTED_MANAGERS+=("$2")
      shift 2
      ;;
    --format)
      (($# >= 2)) || { printf "list-package-versions: --format requires a value\n" >&2; exit 64; }
      FORMAT="$2"
      shift 2
      ;;
    --output)
      (($# >= 2)) || { printf "list-package-versions: --output requires a path\n" >&2; exit 64; }
      OUTPUT="$2"
      shift 2
      ;;
    --help|-h) usage; exit 0 ;;
    *) printf "list-package-versions: unknown option: %s\n" "$1" >&2; exit 64 ;;
  esac
done

case "${FORMAT}" in table|tsv|json|lock) ;; *) printf "list-package-versions: unsupported format: %s\n" "${FORMAT}" >&2; exit 64 ;; esac

REPORT="$(mktemp "${TMPDIR:-/tmp}/package-versions.XXXXXX")"
trap 'rm -f -- "${REPORT}" "${FORMATTED:-}"' EXIT

if is_requested "apt" && command -v dpkg-query >/dev/null 2>&1; then
  dpkg-query --show --showformat='apt\t${binary:Package}\t${Version}\n' >> "${REPORT}"
fi

if is_requested "brew" && command -v brew >/dev/null 2>&1; then
  brew list --versions | awk '{ package=$1; $1=""; sub(/^ /, ""); print "brew\t" package "\t" $0 }' >> "${REPORT}"
fi

if is_requested "rpm" && command -v rpm >/dev/null 2>&1; then
  rpm -qa --qf 'rpm\t%{NAME}\t%{VERSION}-%{RELEASE}\n' >> "${REPORT}"
fi

if is_requested "pacman" && command -v pacman >/dev/null 2>&1; then
  pacman -Q | awk '{ print "pacman\t" $1 "\t" $2 }' >> "${REPORT}"
fi

if is_requested "apk" && command -v apk >/dev/null 2>&1; then
  apk info -v | awk '
    {
      package=$0
      sub(/-[0-9][^-]*(-r[0-9]+)?$/, "", package)
      version=substr($0, length(package) + 2)
      print "apk\t" package "\t" version
    }
  ' >> "${REPORT}"
fi

if is_requested "snap" && command -v snap >/dev/null 2>&1; then
  snap list | awk 'NR > 1 { print "snap\t" $1 "\t" $2 }' >> "${REPORT}"
fi

if is_requested "flatpak" && command -v flatpak >/dev/null 2>&1; then
  flatpak list --columns=application,version | awk -F '\t' '{ print "flatpak\t" $1 "\t" $2 }' >> "${REPORT}"
fi

LC_ALL=C sort -u -o "${REPORT}" "${REPORT}"
FORMATTED="$(mktemp "${TMPDIR:-/tmp}/package-versions-formatted.XXXXXX")"

case "${FORMAT}" in
  table)
    {
      printf "MANAGER\tPACKAGE\tVERSION\n"
      cat "${REPORT}"
    } | if command -v column >/dev/null 2>&1; then column -t -s $'\t'; else cat; fi > "${FORMATTED}"
    ;;
  tsv) cp "${REPORT}" "${FORMATTED}" ;;
  lock) awk -F '\t' '{ print $1 ":" $2 "=" $3 }' "${REPORT}" > "${FORMATTED}" ;;
  json)
    command -v python3 >/dev/null 2>&1 || { printf "list-package-versions: JSON output requires python3\n" >&2; exit 69; }
    python3 - "${REPORT}" > "${FORMATTED}" <<'PY'
import json
import sys

items = []
with open(sys.argv[1], encoding="utf-8") as source:
    for line in source:
        manager, package, version = line.rstrip("\n").split("\t", 2)
        items.append({"manager": manager, "package": package, "version": version})
json.dump(items, sys.stdout, indent=2, sort_keys=True)
sys.stdout.write("\n")
PY
    ;;
esac

if [[ -n "${OUTPUT}" ]]; then
  mkdir -p "$(dirname "${OUTPUT}")"
  install -m 0644 "${FORMATTED}" "${OUTPUT}"
  printf "Wrote %s\n" "${OUTPUT}" >&2
else
  cat "${FORMATTED}"
fi
