#!/usr/bin/env bash
# shellcheck shell=bash
#
# Canonical Bash and Zsh entrypoint.
#
# Source this file from ~/.bashrc or ~/.zshrc. Fish uses its native entrypoint
# at runtime/shells/fish/runtime.fish.

if [[ -n "${EGOHYGIENE_SHELL_INITIALIZED:-}" ]]; then
  return 0
fi

__egohygiene_shell_source_path=""
if [[ -n "${BASH_VERSION:-}" ]]; then
  __egohygiene_shell_source_path="${BASH_SOURCE[0]}"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  # shellcheck disable=SC2296
  __egohygiene_shell_source_path="${(%):-%x}"
else
  printf "[error] .shellrc supports Bash and Zsh; use runtime.fish for Fish\n" >&2
  return 64 2>/dev/null || exit 64
fi

EGOHYGIENE_SHELL_ROOT="$(
  builtin cd -- "$(dirname -- "${__egohygiene_shell_source_path}")" 2>/dev/null &&
    pwd -P
)"

if [[ -z "${EGOHYGIENE_SHELL_ROOT}" || ! -r "${EGOHYGIENE_SHELL_ROOT}/init/init.sh" ]]; then
  printf "[error] unable to resolve the EgoHygiene shell root\n" >&2
  unset __egohygiene_shell_source_path
  return 1 2>/dev/null || exit 1
fi

export EGOHYGIENE_SHELL_ROOT
export EGOHYGIENE_SHELL_INITIALIZED="1"
unset __egohygiene_shell_source_path

# shellcheck disable=SC1091
source "${EGOHYGIENE_SHELL_ROOT}/init/init.sh"
