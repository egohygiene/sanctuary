{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/sanctuary/blob/main/schemas/incubation-manifest.v1.schema.json",
  "title": "Sanctuary incubation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "state",
    "question",
    "owner",
    "reviewers",
    "data_classification",
    "sources",
    "candidate_destinations",
    "exit_criteria",
    "baseline_exceptions",
    "decision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "sanctuary.incubation/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["intake", "exploring", "graduating", "graduated", "archived", "rejected"]
    },
    "question": { "type": "string", "minLength": 1 },
    "owner": { "$ref": "#/$defs/githubLogin" },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/githubLogin" }
    },
    "data_classification": { "const": "public" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "candidate_destinations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repository" }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "baseline_exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "decision": { "$ref": "#/$defs/decision" },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" }
  },
  "$defs": {
    "githubLogin": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "revision", "license", "attribution", "recorded_at"],
      "properties": {
        "kind": { "enum": ["original", "import"] },
        "url": { "type": ["string", "null"], "format": "uri" },
        "revision": { "type": ["string", "null"] },
        "license": { "type": "string", "pattern": "^(?:[A-Za-z0-9-.+]+|LicenseRef-[A-Za-z0-9-.]+)$" },
        "attribution": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "format": "date" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "rationale", "approved_by", "expires_at"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "approved_by": { "$ref": "#/$defs/githubLogin" },
        "expires_at": { "type": "string", "format": "date" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issue", "destination", "decided_at", "rationale"],
      "properties": {
        "status": { "enum": ["pending", "proposed", "approved", "rejected"] },
        "issue": { "type": ["string", "null"], "format": "uri" },
        "destination": { "anyOf": [{ "$ref": "#/$defs/repository" }, { "type": "null" }] },
        "decided_at": { "type": ["string", "null"], "format": "date" },
        "rationale": { "type": ["string", "null"] }
      }
    }
  }
}
